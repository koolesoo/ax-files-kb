# Локальная разработка — скопируйте в .env
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_SCORE_THRESHOLD=0.32
RAG_ASK_MIN_SCORE=0.12

# Netlify: задайте те же переменные в Site settings → Environment variables
# NETLIFY=true выставляется автоматически в netlify.toml
